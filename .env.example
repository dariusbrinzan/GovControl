# Local development only. Copy this file to .env and use a unique local password.
POSTGRES_DB=govcontrol
POSTGRES_USER=govcontrol
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Reserved for the FastAPI application added in the next milestone.
DATABASE_URL=postgresql+asyncpg://govcontrol:replace-with-a-local-password@localhost:5432/govcontrol
