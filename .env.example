# Local development only. Copy this file to .env and use unique local secrets.
APP_ENV=development
POSTGRES_DB=govcontrol
POSTGRES_USER=govcontrol
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
API_PORT=8000
CONTRACTS_API_PORT=8010
GATEWAY_PORT=8080
WEB_PORT=3000

DATABASE_URL=postgresql+asyncpg://govcontrol:replace-with-a-local-password@localhost:5432/govcontrol
CONTRACTS_DATABASE_URL=postgresql+asyncpg://govcontrol:replace-with-a-local-password@localhost:5432/govcontrol
PLATFORM_API_URL=http://127.0.0.1:8000/api/v1
CONTRACTS_API_URL=http://127.0.0.1:8010/api/v1

# Local infrastructure used by independently running services and background jobs.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
EVENT_STREAM_NAME=govcontrol.events
OBJECT_STORAGE_ACCESS_KEY=govcontrol
OBJECT_STORAGE_SECRET_KEY=replace-with-a-local-storage-password
OBJECT_STORAGE_BUCKET=govcontrol-documents
OBJECT_STORAGE_PORT=9000
# Direct API development defaults to local files. Docker Compose overrides this with `s3`.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./data/documents
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=govcontrol
S3_SECRET_KEY=replace-with-a-local-storage-password
S3_BUCKET=govcontrol-documents
S3_REGION=us-east-1

# Temporary local authentication. Never enable this outside local development.
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN=replace-with-a-long-random-local-token
DEV_AUTH_EMAIL=admin@govcontrol.local

# Shared only between backend services in local development. Use a generated secret in production.
INTERNAL_SERVICE_TOKEN=replace-with-a-separate-long-random-service-token
GATEWAY_ASSERTION_SECRET=replace-with-a-separate-gateway-assertion-secret
SESSION_SIGNING_SECRET=replace-with-a-separate-session-signing-secret

# Gateway/BFF. `local` is allowed only in development; production must use `oidc`.
AUTH_MODE=local
GATEWAY_URL=http://127.0.0.1:8080
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
PORTAL_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORTAL_AFTER_LOGIN_URL=http://localhost:3000/legal
SESSION_TTL_SECONDS=28800
SESSION_ROTATION_SECONDS=1800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
GATEWAY_RATE_LIMIT_REQUESTS=240
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60

# Required when AUTH_MODE=oidc. Leave empty for the local development login.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback
OIDC_TRUSTED_ISSUERS=
FEDERATED_EMAIL_LINKING_ENABLED=false

# Direct-service CORS is needed only for host debugging; the portal normally calls the gateway.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RESPONSE_COMPRESSION_MINIMUM_SIZE=1000
