# Local development only. Copy this file to .env and use unique local secrets.
APP_ENV=development
POSTGRES_DB=govcontrol
POSTGRES_USER=govcontrol
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://govcontrol:replace-with-a-local-password@localhost:5432/govcontrol
CONTRACTS_DATABASE_URL=postgresql+asyncpg://govcontrol:replace-with-a-local-password@localhost:5432/govcontrol
PLATFORM_API_URL=http://127.0.0.1:8000/api/v1

# Local infrastructure used by independently running services and background jobs.
REDIS_PORT=6379
MINIO_ROOT_USER=govcontrol
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Temporary local authentication. Never enable this outside local development.
DEV_AUTH_ENABLED=true
DEV_AUTH_TOKEN=replace-with-a-long-random-local-token
DEV_AUTH_EMAIL=admin@govcontrol.local

# Browser origin permitted to call the local API and optional frontend API override.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RESPONSE_COMPRESSION_MINIMUM_SIZE=1000
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# NEXT_PUBLIC_CONTRACTS_API_URL=http://127.0.0.1:8010/api/v1
